{
  "schema_version": "phase2-iteration2-offline-protocol-v1",
  "protocol_id": "phase2-iteration2-official-term-index-2026-09-14",
  "registered_at": "2026-09-14",
  "status": "development_only_registered_before_execution",
  "objective": "Medir se termos oficiais rastreáveis tornam fenótipos sem rótulo português representáveis e melhoram o ranking de paráfrases em trechos-ouro, sem alterar a aplicação.",
  "authorization": {
    "approved_by_po": true,
    "approved_scope": "Conceitos sem tradução portuguesa oficial podem ser avaliados se identificados explicitamente, exibirem o rótulo oficial inglês, registrarem fonte e versão e exigirem revisão humana.",
    "application_integration_authorized": false
  },
  "inputs": {
    "dataset": "data/eval/phase2_development.json",
    "allowed_split": "development",
    "ontology": "data/processed/hpo_ontology.json.gz",
    "metadata": "data/processed/metadata.json",
    "baseline": "data/protocol/phase2_baseline_freeze.json",
    "scope_root": "HP:0000118",
    "include_scope_root": false
  },
  "term_policy": {
    "concepts": "all_descendants_of_HP_0000118",
    "fields": [
      "official_label_pt",
      "official_label_en",
      "official_exact_synonym_en"
    ],
    "unverified_portuguese_terms_allowed": false,
    "empty_portuguese_label_status": "unavailable",
    "duplicate_term_policy": "deduplicate_by_hpo_id_language_field_normalized_text",
    "candidate_score_policy": "maximum_term_score_per_hpo_id",
    "tie_break": "hpo_id_ascending"
  },
  "methods": [
    "baseline_pt_fuzzy",
    "official_terms_exact",
    "official_terms_fuzzy",
    "official_terms_bm25",
    "official_terms_sapbert_if_cached"
  ],
  "evaluation": {
    "linking_input": "gold_mention_text",
    "top_k": 5,
    "metrics": [
      "accuracy_at_1",
      "accuracy_at_5",
      "mrr_at_5"
    ],
    "stratify_by": [
      "label_pt_status"
    ],
    "end_to_end_detector": "iteration_1_translated_phenotype_fuzzy_windows",
    "detector_threshold": 0.92,
    "detector_max_span_tokens": 5,
    "negative_controls": "all_development_cases_without_annotations",
    "latency_is_descriptive_only": true
  },
  "decision_rule": {
    "numeric_clinical_gate_approved": false,
    "minimum_evidence_for_future_integration_recommendation": [
      "accuracy_at_5_strictly_exceeds_baseline_pt_fuzzy",
      "at_least_one_target_without_pt_label_is_retrieved_at_5",
      "automatic_negative_control_false_positives_do_not_increase"
    ],
    "development_success_is_generalization_evidence": false,
    "integration_in_this_iteration": false
  },
  "prohibitions": {
    "validation_or_holdout": true,
    "network_download": true,
    "official_dataset_modification": true,
    "invented_translation": true,
    "external_model_or_service": true,
    "patient_data": true,
    "application_code_change": true
  }
}
